--  This is the default version of the target_options.gpr file,
--  imported by runtime_build.gpr. Variables defined here are appended
--  to the corresponding variables there. Target configurations may
--  their own version of this file.

abstract project Target_Options is

  type Build_Type is ("Production", "Debug", "Assert", "Gnatcov");
  Build : Build_Type := external ("BUILD", "Production");
  type Lib_Type is ("static", "static-pic", "dynamic");
  Lib : Lib_Type := external ("LIBRARY_TYPE", "static");

  Common_Switches := ("{common_switches}");
  Runtime_Gnarl_Switches := ("{runtime_gnarl_switches}");
  Runtime_Debug_Switches := ("{runtime_debug_switches}");

  --  Per language; Common_Switches joins them at the end of this file.
  Ada_Switches := ("-gnatg", "-nostdinc", "-fno-delete-null-pointer-checks");
  Asm_Switches := ("{asm_switches}");
  C_Switches := ("{c_switches}", "-Werror", "-Wall");
  case Build is
     when "Production" =>
        --  Optimize
        Common_Switches := Common_Switches & ("-O2");
        Ada_Switches := Ada_Switches & ("-gnatp", "-gnatn2");
     when "Debug" =>
        --  Disable optimization and add debug symbols
        Common_Switches := Common_Switches & Runtime_Debug_Switches & ("-O0");
        Asm_Switches := Asm_Switches & Runtime_Debug_Switches;
     when "Assert" =>
        --  Possibly enable assertions. This might use too much memory on
        --  some systems or could be too slow.
        Common_Switches := Common_Switches & ("-O");
        Ada_Switches := Ada_Switches & ("-gnata");
     when "Gnatcov" =>
        --  For coverage
        Common_Switches := Common_Switches & Runtime_Debug_Switches &
          ("-O0", "-fdump-scos", "-fpreserve-control-flow");
  end case;
  Runtime_Link_Switches := ();
  case Lib is
     when "static" | "static-pic" =>
        null;
     when "dynamic" =>
        --  -nostdlib is required for building the
        --  shared library. Otherwise it tries to
        --  link against libgnat (itself).
        --  Since -nostdlib also removes libc
        --  from the linked libraries we have to
        --  add -lc again.
        Runtime_Link_Switches :=
          Runtime_Link_Switches & ("-nostdlib", "-lc");

        --  Add target-specific options, if needed
        Runtime_Link_Switches :=
          Runtime_Link_Switches & ("{runtime_link_switches}");
  end case;

  All_Ada_Switches := Ada_Switches & Common_Switches;
  All_C_Switches := C_Switches & Common_Switches;
  All_Asm_Switches := Asm_Switches;
  Gnarl_Ada_Switches := All_Ada_Switches & Runtime_Gnarl_Switches;
  Gnarl_C_Switches := All_C_Switches & Runtime_Gnarl_Switches;
  Gnarl_Asm_Switches := Asm_Switches;

end Target_Options;
