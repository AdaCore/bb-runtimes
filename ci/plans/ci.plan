# Anod CI plan for bb-runtimes.
#
# Builds the recompilable runtimes (recompilablerts spec, in the anod specs
# repo) across the cross targets the spec supports. board_list in the spec
# picks the default per-target runtimes subset, so only the anod target is varied.


TARGETS = [
    # Bareboard
    "arm-elf",
    "aarch64-elf",
    "leon3-elf",
    "morello-elf",
    "ppc-elf",
    "riscv32-elf",
    "riscv64-elf",
    "x86_64-elf",
    # Cross targets
    "arm-deos",
    "arm-freertos,,qemu-zynq",
    "arm-pikeos5,5.0",
    "aarch64-qnx,8.0",
    "aarch64-vx7r2cert,helix-cert-23.06",
]


def build():
    for target in TARGETS:
        anod_build("recompilablerts", target=target)


# TODO when stabilized we can add build with the qualifier "build-type=Assert"
